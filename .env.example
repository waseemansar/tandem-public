# The person this twin represents. Unset falls back to neutral placeholders.
NEXT_PUBLIC_OWNER_FULL_NAME="Your Name"
NEXT_PUBLIC_OWNER_FIRST_NAME="You"

# Pronouns for the twin prompt and conversation copy.
# Subject/object/possessive, e.g. she/her/her, he/him/his, they/them/their.
NEXT_PUBLIC_OWNER_PRONOUN_SUBJECT=they
NEXT_PUBLIC_OWNER_PRONOUN_OBJECT=them
NEXT_PUBLIC_OWNER_PRONOUN_POSSESSIVE=their

# Public path to the owner's photo.
NEXT_PUBLIC_OWNER_PHOTO=/placeholder-avatar.png

# Postgres connection for the running app. Tests use their own ephemeral DB.
DATABASE_URL=postgres://tandem:tandem@localhost:5432/tandem

# OpenAI API key for the TwinAgent. Required; missing key fails fast on first reply.
OPENAI_API_KEY=sk-...

# TwinAgent model (defaults to gpt-5-mini) and trace environment tag.
OPENAI_TWIN_MODEL=gpt-5-mini
OPENAI_TRACE_ENV=production

# Auth.js session secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Trust the deployment host header — required behind a reverse proxy (e.g. Railway).
AUTH_TRUST_HOST=true

# Admin seed, read only by `scripts/seed-admin.ts`. Not read by the running app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pushover "awaiting you" notifications (app token + user key). Unset = no notifications.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Public base URL for notification and magic-link deep links. Defaults to localhost:3000.
APP_BASE_URL=http://localhost:3000

# Resend magic-link emails. Unset = feature no-ops with a warning.
# RESEND_FROM_EMAIL prefers the "Display Name <addr>" form so clients show a sender name.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tandem <notifications@send.example.com>"

# Magic-link signing secret (separate from AUTH_SECRET). Generate with `openssl rand -base64 32`.
# Rotating it invalidates all in-flight magic links.
MAGIC_LINK_SECRET=

# Anti-abuse: max visitor messages per minute per conversation. Defaults to 10.
RATE_LIMIT_CONVERSATION_PER_MINUTE=10

# Anti-abuse: max visitor requests per minute per client IP (IPv6 /64). Defaults to 60.
RATE_LIMIT_IP_PER_MINUTE=60

# Kill switch. Exactly "true" makes every visitor message get an escalation-only reply.
DISABLE_TWIN=false
