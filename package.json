{
    "name": "tandem",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "preview:emails": "email dev --dir src/shared/email/templates --port 3001",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
        "seed:knowledge": "tsx --env-file=.env scripts/seed-knowledge.ts",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=20"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "prettier --write",
            "eslint --fix --max-warnings 0"
        ],
        "*.{json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@openai/agents": "^0.11.6",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.8",
        "@tanstack/react-query": "^5.101.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "jose": "^6.2.3",
        "lucide-react": "^1.17.0",
        "next": "16.2.7",
        "next-auth": "5.0.0-beta.31",
        "next-themes": "^0.4.6",
        "postgres": "^3.4.9",
        "radix-ui": "^1.4.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-markdown": "^10.1.0",
        "shadcn": "^4.10.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "sharp",
            "unrs-resolver"
        ]
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@react-email/ui": "^6.6.0",
        "@tailwindcss/postcss": "^4",
        "@testcontainers/postgresql": "^12.0.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-next": "16.2.7",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "react-email": "^6.6.0",
        "tailwindcss": "^4",
        "testcontainers": "^12.0.1",
        "tsx": "^4.22.4",
        "typescript": "^5",
        "vitest": "^4.1.8"
    }
}
