# Playwright E2E env (pnpm test:e2e). Copy to .env.test and fill in the real OPENAI_API_KEY.
# Prerequisite: `docker compose up -d postgres-e2e` (E2E Postgres on host port 5433).

DATABASE_URL=postgres://tandem:tandem@localhost:5433/tandem_e2e

# Owner identity pinned to Waseem so server text, seeded doc, and UI labels agree.
NEXT_PUBLIC_OWNER_FULL_NAME="Waseem Ansar"
NEXT_PUBLIC_OWNER_FIRST_NAME=Waseem
NEXT_PUBLIC_OWNER_PRONOUN_SUBJECT=he
NEXT_PUBLIC_OWNER_PRONOUN_OBJECT=him
NEXT_PUBLIC_OWNER_PRONOUN_POSSESSIVE=his

# Real OpenAI key. E2E runs the twin against gpt-5-nano (cheap, fast).
OPENAI_API_KEY=sk-...
OPENAI_TWIN_MODEL=gpt-5-nano
OPENAI_TRACE_ENV=e2e

# Fixed secrets. MAGIC_LINK_SECRET must match what the server reads — tests mint tokens in-process.
AUTH_SECRET=e2e-auth-secret-please-change-locally-32bytes
AUTH_TRUST_HOST=true
MAGIC_LINK_SECRET=e2e-magic-link-secret-please-change-locally-32bytes

# Where the test app is served; Playwright reads PORT from this URL.
APP_BASE_URL=http://localhost:3100

# Seeded admin for the credentials sign-in test.
ADMIN_EMAIL=e2e-admin@tandem.test
ADMIN_PASSWORD=e2e-admin-password

# Held empty so email/notifier fall back to no-ops — no external HTTP fires during E2E.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Anti-abuse: max visitor messages per minute per conversation. Defaults to 10.
RATE_LIMIT_CONVERSATION_PER_MINUTE=10

# Anti-abuse: max visitor requests per minute per client IP (IPv6 /64). Defaults to 60.
RATE_LIMIT_IP_PER_MINUTE=60

# Kill switch. Exactly "true" makes every visitor message get an escalation-only reply.
DISABLE_TWIN=false
